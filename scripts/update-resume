#!/usr/bin/env bash
# Upload/replace the resume PDF on the Longhorn volume.
# Normalizes /Lang + /Title in-cluster (resume-tools image), writes documents/resume.pdf.
# Usage: scripts/update-resume <file.pdf>
set -euo pipefail

NS=michaeldelamorena-com
PVC=resume-content
: "${REGISTRY_DOMAIN:?source ~/.zshrc first (REGISTRY_DOMAIN unset)}"
IMAGE="${REGISTRY_DOMAIN}/resume-tools:latest"
POD="resume-uploader-$$"

file="${1:-}"
[ -n "$file" ] || { echo "usage: scripts/update-resume <file.pdf>" >&2; exit 2; }
[ -f "$file" ] || { echo "no such file: $file" >&2; exit 1; }
case "$file" in
  *.pdf) ;;
  *) echo "not a .pdf: $file" >&2; exit 1 ;;
esac
# Reject anything without a PDF magic header.
if [ "$(head -c 4 "$file")" != "%PDF" ]; then
  echo "not a valid PDF (missing %PDF header): $file" >&2
  exit 1
fi

cleanup() { kubectl delete pod "$POD" -n "$NS" --ignore-not-found --wait=false >/dev/null 2>&1 || true; }
trap cleanup EXIT

echo "Starting uploader pod $POD ..."
kubectl run "$POD" -n "$NS" --image="$IMAGE" --restart=Never --overrides='{
  "spec": {
    "securityContext": {"runAsUser": 0, "runAsGroup": 0},
    "imagePullSecrets": [{"name": "my-registry-secret"}],
    "containers": [{
      "name": "uploader",
      "image": "'"$IMAGE"'",
      "command": ["sleep", "infinity"],
      "volumeMounts": [{"name": "vol", "mountPath": "/mnt"}]
    }],
    "volumes": [{"name": "vol", "persistentVolumeClaim": {"claimName": "'"$PVC"'"}}]
  }
}'

kubectl wait --for=condition=Ready "pod/$POD" -n "$NS" --timeout=120s
kubectl cp "$file" "$NS/$POD:/tmp/incoming.pdf"
# The volume root holds a root-owned lost+found; the serving pod mounts the
# "documents" subdir via subPath to avoid it. Write there and make it
# world-readable so the read-only uid-1001 serving pod can serve it
# (Longhorn RWX/NFS does not reliably honor fsGroup).
kubectl exec -n "$NS" "$POD" -- mkdir -p /mnt/documents
kubectl exec -n "$NS" "$POD" -- python3 /usr/local/bin/patch_pdf.py /tmp/incoming.pdf /mnt/documents/resume.pdf
kubectl exec -n "$NS" "$POD" -- sh -c 'chmod 0755 /mnt/documents && chmod 0644 /mnt/documents/resume.pdf'
echo -n "on-volume checksum: "; kubectl exec -n "$NS" "$POD" -- md5sum /mnt/documents/resume.pdf
echo "documents/resume.pdf updated on volume '$PVC'."

# Purge the CDN so the new resume is served immediately (not after the ~24h TTL).
# Provide this site's Cloudflare zone id via CLOUDFLARE_ZONE_ID_MDLM
# (do NOT hardcode it — zone ids are private infra ids).
CF_ZONE_ID="${CLOUDFLARE_ZONE_ID_MDLM:-}"
if [ -n "${CLOUDFLARE_CACHE_PURGE_TOKEN:-}" ] && [ -n "$CF_ZONE_ID" ]; then
  echo "Purging Cloudflare cache for the resume URLs..."
  purge_resp=$(curl -s -X POST "https://api.cloudflare.com/client/v4/zones/${CF_ZONE_ID}/purge_cache" \
    -H "Authorization: Bearer ${CLOUDFLARE_CACHE_PURGE_TOKEN}" \
    -H "Content-Type: application/json" \
    --data '{"files":["https://michaeldelamorena.com/resume.pdf","https://michaeldelamorena.com/documents/resume.pdf"]}')
  if echo "$purge_resp" | grep -q '"success":true'; then
    echo "cache purged — new resume is live."
  else
    echo "WARNING: cache purge failed (new PDF may be cached up to ~24h): $purge_resp"
  fi
else
  echo "NOTE: set CLOUDFLARE_CACHE_PURGE_TOKEN and CLOUDFLARE_ZONE_ID_MDLM to auto-purge the CDN — skipped (new PDF may be cached up to ~24h)."
fi
